            "description": "Successful Response"
          }
        },
        "summary": "Read Configuration",
        "tags": [
          "configuration"
        ]
      },
      "put": {
        "operationId": "write_configuration_api_v1_config_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppConfiguration"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppConfiguration"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Write Configuration",
        "tags": [
          "configuration"
        ]
      }
    },
    "/api/v1/health": {
