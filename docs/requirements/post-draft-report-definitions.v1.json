    {
      "template_key": "personal_board.unavailable",
      "section_key": "personal_board_choice_moments",
      "template": "Personal Board choice moments are unavailable because the frozen rank history could not be read safely.",
      "required_placeholders": []
    },
    {
      "template_key": "alerts.summary",
      "section_key": "recorded_alert_moments",
      "template": "The saved draft history contains {alert_event_count} recorded alert events.",
      "required_placeholders": [
        "alert_event_count"
      ]
    },
    {
      "template_key": "alerts.unavailable",
      "section_key": "recorded_alert_moments",
      "template": "Recorded alert moments are unavailable because the saved event history could not be read safely.",
      "required_placeholders": []
    },
    {
      "template_key": "comparison.compatible",
      "section_key": "evidence_limits",
      "template": "{report_count} reports share the required league shape and rules version for descriptive comparison.",
      "required_placeholders": [
        "report_count"
      ]
    },
    {
      "template_key": "comparison.not_comparable",
      "section_key": "evidence_limits",
      "template": "This section cannot be compared because one or more selected reports lacks compatible support.",
      "required_placeholders": []
    },
    {
      "template_key": "report.limits",
      "section_key": "evidence_limits",
      "template": "This report describes saved draft evidence, does not project outcomes, and leaves user judgment authoritative.",
      "required_placeholders": []
    }
  ],
  "forbidden_language": [
    "draft grade",
    "a+ draft",
    "best roster",
    "worst roster",
    "winner",
    "championship team",
    "contender",
    "guaranteed",
    "elite",
    "mistake",
    "bad pick",
    "steal",
    "bust",
    "must trade",
    "should have drafted"
  ],
  "privacy_forbidden_fields": [
    "provider_id",
    "source_player_key",
    "private_source_reference",
    "raw_evidence",
    "personal_board_notes",
    "private_strategy_notes",
    "cpu_seed",
    "random_audit",
    "manager_internal_reference",
    "input_fingerprint"
  ]
}
