      "applicable_modes": [
        "live",
        "mock"
      ],
      "reason_codes": [
        "LIVE_STRATEGY_NOT_APPLICABLE",
        "MOCK_STRATEGY_HISTORY_AVAILABLE",
        "MOCK_STRATEGY_HISTORY_LIMITED"
      ],
      "limitation_codes": [
        "SAVED_EVENTS_ONLY"
      ]
    },
    {
      "section_key": "personal_board_choice_moments",
      "title": "Personal Board choice moments",
      "availability_rule": "frozen_board_snapshot",
      "confidence_ceiling": "high",
      "applicable_modes": [
        "live",
        "mock"
      ],
      "reason_codes": [
        "NO_QUALIFYING_PERSONAL_BOARD_MOMENTS",
        "PERSONAL_BOARD_MOMENTS_AVAILABLE"
      ],
      "limitation_codes": [
