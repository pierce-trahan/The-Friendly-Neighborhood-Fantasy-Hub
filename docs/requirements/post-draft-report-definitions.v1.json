{
  "schema_version": 1,
  "rules_version": "post-draft-report-rules-v1",
  "explanation_template_version": "post-draft-report-explanations-v1",
  "availability_states": [
    "supported",
    "limited",
    "unavailable",
    "not_applicable"
  ],
  "confidence_states": [
    "high",
    "medium",
    "low",
    "unavailable"
  ],
  "section_registry": [
    {
      "section_key": "draft_summary",
      "title": "Draft summary",
      "availability_rule": "always_supported",
      "confidence_ceiling": "high",
      "applicable_modes": [
        "live",
        "mock"
      ],
      "reason_codes": [],
      "limitation_codes": []
    },
    {
      "section_key": "position_inventory",
