      ]
    },
    {
      "section_key": "recorded_alert_moments",
      "title": "Recorded alert moments",
      "availability_rule": "saved_alert_history",
      "confidence_ceiling": "high",
      "applicable_modes": [
        "live",
        "mock"
      ],
      "reason_codes": [
        "ALERTS_CONFIGURED_NO_EVENTS",
        "ALERTS_DISABLED_AT_COMPLETION",
        "ALERTS_NOT_CONFIGURED",
        "ALERT_EVENTS_AVAILABLE",
        "ALERT_HISTORY_CORRUPT"
