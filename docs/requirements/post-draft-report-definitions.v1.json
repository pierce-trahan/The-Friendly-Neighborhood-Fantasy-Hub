    {
      "section_key": "evidence_limits",
      "title": "Evidence limits",
      "availability_rule": "always_supported",
      "confidence_ceiling": "high",
      "applicable_modes": [
        "live",
        "mock"
      ],
      "reason_codes": [
        "REPORT_LIMITS_DISCLOSED"
      ],
      "limitation_codes": [
        "NO_OUTCOME_PROJECTION",
        "USER_JUDGMENT_AUTHORITATIVE"
      ]
    }
  ],
  "starter_assignment": {
    "algorithm": "maximum_bipartite_matching",
    "objective": "maximize_filled_starter_slots",
    "slot_order_origin": 0,
    "tie_break_fields": [
      "slot_order",
      "overall_pick",
      "canonical_player_id"
    ],
    "assignment_vector_order": "lexicographically_smallest_filled_edge_tuple_list",
    "unknown_eligibility": "no_edge_and_limited_when_assignment_remains_usable",
    "depth_grouping": "frozen_primary_position",
    "ambiguous_flex_rule": "chosen_player_replaceable_in_another_maximum_assignment",
    "supported_slot_types": {
      "QB": [
        "QB"
      ],
      "RB": [
        "RB"
      ],
      "WR": [
        "WR"
      ],
      "TE": [
        "TE"
      ],
      "FLEX": [
        "RB",
        "WR",
        "TE"
      ],
      "SUPER_FLEX": [
        "QB",
        "RB",
        "WR",
        "TE"
      ]
    }
  },
  "evidence_coverage": {
    "formula": "floor(covered_players*10000/roster_players)",
    "limited_minimum_basis_points": 5000,
    "supported_minimum_basis_points": 8000,
    "below_limited_availability": "unavailable",
    "limited_availability": "limited",
    "supported_availability": "supported",
    "supported_confidence": "medium",
    "limited_confidence": "low",
    "unavailable_confidence": "unavailable",
    "confidence_ceiling": "medium",
    "blocking_evidence_states": [
      "expired",
      "incompatible",
      "invalid"
    ],
    "applies_to_sections": [
      "age_risk_profile",
      "dynasty_market_context",
      "year_one_production_context"
    ]
  },
  "concentration": {
    "formula": "floor(position_pick_count*10000/total_user_picks)",
    "balanced_maximum_basis_points": 4000,
    "highly_concentrated_above_basis_points": 5500,
    "balanced_requires_full_distinct_starter_coverage": true,
    "coverage_gap_can_coexist": true,
    "share_bands": [
      "balanced_distribution",
      "concentrated",
      "highly_concentrated"
    ]
  },
  "limits": {
    "maximum_candidates": 500,
    "maximum_user_roster_picks": 60,
    "maximum_sections": 100,
    "maximum_personal_board_moments": 10,
    "maximum_exported_alert_moments": 20,
    "minimum_comparison_reports": 2,
    "maximum_comparison_reports": 4
  },
  "explanation_templates": [
    {
      "template_key": "starter.coverage_complete",
      "section_key": "starter_coverage",
      "template": "All {starter_slots_total} configured starter slots can be covered by the drafted roster.",
      "required_placeholders": [
        "starter_slots_total"
      ]
    },
    {
      "template_key": "starter.coverage_partial",
      "section_key": "starter_coverage",
      "template": "{starter_slots_filled} of {starter_slots_total} configured starter slots can be covered; review the unfilled slot labels.",
      "required_placeholders": [
        "starter_slots_filled",
        "starter_slots_total"
      ]
    },
    {
      "template_key": "starter.coverage_unavailable",
      "section_key": "starter_coverage",
      "template": "Starter coverage is unavailable because the saved league starter shape could not be normalized.",
      "required_placeholders": []
    },
    {
      "template_key": "concentration.balanced",
      "section_key": "roster_concentration",
      "template": "No position accounts for more than {balanced_maximum_percent}% of the roster, and every distinct starter position is covered.",
      "required_placeholders": [
        "balanced_maximum_percent"
      ]
    },
    {
      "template_key": "concentration.concentrated",
      "section_key": "roster_concentration",
      "template": "{position} accounts for {position_share_percent}% of the roster, above the V1 concentration boundary.",
      "required_placeholders": [
        "position",
        "position_share_percent"
      ]
    },
    {
      "template_key": "concentration.highly_concentrated",
      "section_key": "roster_concentration",
      "template": "{position} accounts for {position_share_percent}% of the roster, above the V1 high-concentration boundary.",
      "required_placeholders": [
        "position",
        "position_share_percent"
      ]
    },
    {
      "template_key": "concentration.coverage_gap",
      "section_key": "roster_concentration",
      "template": "{unfilled_position_count} distinct configured starter position group remains uncovered.",
      "required_placeholders": [
        "unfilled_position_count"
      ]
    },
    {
      "template_key": "production.supported",
      "section_key": "year_one_production_context",
      "template": "Saved categorical production evidence covers {covered_players} of {roster_players} rostered players.",
      "required_placeholders": [
        "covered_players",
        "roster_players"
      ]
    },
    {
      "template_key": "production.limited",
      "section_key": "year_one_production_context",
      "template": "Saved categorical production evidence covers {covered_players} of {roster_players} rostered players, so this context is limited.",
      "required_placeholders": [
        "covered_players",
        "roster_players"
      ]
    },
    {
      "template_key": "production.unavailable",
      "section_key": "year_one_production_context",
      "template": "Year-one production context is unavailable because the saved draft lacks enough compatible, usable evidence.",
      "required_placeholders": []
    },
    {
      "template_key": "market.supported",
      "section_key": "dynasty_market_context",
      "template": "Saved categorical market evidence covers {covered_players} of {roster_players} rostered players.",
      "required_placeholders": [
        "covered_players",
        "roster_players"
      ]
    },
    {
      "template_key": "market.limited",
      "section_key": "dynasty_market_context",
      "template": "Saved categorical market evidence covers {covered_players} of {roster_players} rostered players, so this context is limited.",
      "required_placeholders": [
        "covered_players",
        "roster_players"
      ]
    },
    {
      "template_key": "market.unavailable",
      "section_key": "dynasty_market_context",
      "template": "Dynasty market context is unavailable because the saved draft lacks enough compatible, usable evidence.",
      "required_placeholders": []
    },
    {
      "template_key": "age_risk.supported",
      "section_key": "age_risk_profile",
      "template": "Saved categorical age-risk evidence covers {covered_players} of {roster_players} rostered players.",
      "required_placeholders": [
        "covered_players",
        "roster_players"
      ]
    },
    {
      "template_key": "age_risk.limited",
      "section_key": "age_risk_profile",
      "template": "Saved categorical age-risk evidence covers {covered_players} of {roster_players} rostered players, so this profile is limited.",
      "required_placeholders": [
