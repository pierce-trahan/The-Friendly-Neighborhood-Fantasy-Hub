    {
      "template_key": "age_risk.unavailable",
      "section_key": "age_risk_profile",
      "template": "Age profile is unavailable because the saved draft does not contain enough approved age-risk evidence.",
      "required_placeholders": []
    },
    {
      "template_key": "long_term.unavailable",
      "section_key": "long_term_value",
      "template": "Long-term dynasty value is unavailable because V1 has no approved outcome evidence for this claim.",
      "required_placeholders": []
