      ],
      "reason_codes": [],
      "limitation_codes": []
    },
    {
      "section_key": "starter_coverage",
      "title": "Starter coverage",
      "availability_rule": "normalized_league_shape",
      "confidence_ceiling": "high",
      "applicable_modes": [
        "live",
        "mock"
      ],
      "reason_codes": [
        "STARTER_ASSIGNMENT_COMPLETE",
        "STARTER_ASSIGNMENT_PARTIAL",
        "STARTER_SHAPE_UNAVAILABLE"
      ],
