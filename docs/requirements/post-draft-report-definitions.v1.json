      "required_placeholders": []
    },
    {
      "template_key": "strategy.not_applicable",
      "section_key": "strategy_story",
      "template": "Strategy story does not apply to this live draft.",
      "required_placeholders": []
    },
    {
      "template_key": "personal_board.moment",
      "section_key": "personal_board_choice_moments",
      "template": "At pick {overall_pick}, you selected {selected_player} while {passed_player} was {rank_delta} places higher on the saved Personal Board.",
      "required_placeholders": [
        "overall_pick",
        "passed_player",
        "rank_delta",
        "selected_player"
      ]
    },
    {
      "template_key": "personal_board.summary",
      "section_key": "personal_board_choice_moments",
      "template": "The frozen Personal Board reconstruction contains {moment_count} qualifying choice moments.",
      "required_placeholders": [
        "moment_count"
      ]
