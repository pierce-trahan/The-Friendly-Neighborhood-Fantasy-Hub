{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friendly-neighborhood-fantasy-hub.local/schemas/alert-evidence-snapshot.schema.json",
  "title": "Friendly Neighborhood Fantasy Hub Alert Evidence Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_key",
    "source",
    "as_of",
    "format",
    "supported_draft_depth",
    "player_signals",
    "pick_values"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "snapshot_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "format": {
      "$ref": "#/$defs/format"
    },
    "supported_draft_depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "player_signals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/playerSignal"
      }
    },
    "pick_values": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/pickValue"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "kind",
        "namespace",
        "permitted_use_confirmed"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "enum": [
            "synthetic",
            "user_entered",
            "public",
            "licensed"
          ]
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "permitted_use_confirmed": {
          "const": true
        },
        "private_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sport",
        "league_type",
        "draft_purpose",
        "team_count",
        "draft_format",
        "third_round_reversal",
        "rounds",
        "qb_mode",
        "reception_scoring",
        "te_premium"
      ],
      "properties": {
        "sport": {
          "const": "nfl"
        },
        "league_type": {
          "enum": [
            "dynasty",
            "keeper",
            "redraft"
          ]
        },
        "draft_purpose": {
          "enum": [
            "startup",
            "rookie",
            "supplemental"
          ]
        },
        "team_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 32
        },
        "draft_format": {
          "enum": [
            "snake",
            "linear"
          ]
        },
        "third_round_reversal": {
          "type": "boolean"
        },
        "rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "qb_mode": {
          "enum": [
            "one_qb",
            "superflex"
          ]
        },
        "reception_scoring": {
          "enum": [
            "standard",
            "half_ppr",
            "ppr"
          ]
        },
        "te_premium": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "draft_format": {
                "const": "linear"
              }
            },
            "required": [
              "draft_format"
            ]
          },
          "then": {
            "properties": {
              "third_round_reversal": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "playerSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_player_key",
        "display_name",
        "position",
        "team",
        "expected_pick",
        "market_band",
        "win_now_production_band",
        "age_risk_band",
        "evidence_as_of",
        "limitation_codes"
      ],
      "properties": {
        "source_player_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "position": {
          "enum": [
            "QB",
            "RB",
            "WR",
            "TE",
            "K",
            "DEF",
            "DL",
            "LB",
            "DB"
          ]
        },
        "team": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 2,
          "maxLength": 8
        },
        "expected_pick": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/range"
            }
          ]
        },
        "market_band": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "premium",
            "strong",
            "standard",
            "depth",
            "fringe",
            null
          ]
        },
        "win_now_production_band": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            null
          ]
        },
        "age_risk_band": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "lower",
            "middle",
            "higher",
            null
          ]
        },
        "evidence_as_of": {
          "type": "string",
          "format": "date-time"
        },
        "limitation_codes": {
          "$ref": "#/$defs/limitationCodes"
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "low",
        "high"
      ],
      "properties": {
        "low": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "high": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "pickValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_key",
        "asset_type",
        "overall_pick",
        "season_offset",
        "round",
        "value_low",
        "value_high",
        "evidence_as_of",
        "limitation_codes"
      ],
      "properties": {
        "asset_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "asset_type": {
          "enum": [
            "current_draft_pick",
            "future_round"
          ]
        },
        "overall_pick": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 10000
        },
        "season_offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "round": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 10
        },
        "value_low": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "value_high": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "evidence_as_of": {
          "type": "string",
          "format": "date-time"
        },
        "limitation_codes": {
          "$ref": "#/$defs/limitationCodes"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "asset_type": {
                "const": "current_draft_pick"
              }
            },
            "required": [
              "asset_type"
            ]
          },
          "then": {
            "properties": {
              "overall_pick": {
                "type": "integer"
              },
              "season_offset": {
                "type": "null"
              },
              "round": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "asset_type": {
                "const": "future_round"
              }
            },
            "required": [
              "asset_type"
            ]
          },
          "then": {
            "properties": {
              "overall_pick": {
                "type": "null"
              },
              "season_offset": {
                "type": "integer"
              },
              "round": {
                "type": "integer"
              }
            }
          }
        }
      ]
    },
    "limitationCodes": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 80,
        "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
      }
    }
  }
}
